---
import '../../styles/tailwind.css';
import '../../styles/global.scss';
import Nav from '../global/Nav.astro';
import Footer from '../global/Footer.astro';
import ScrollToTop from '../ui/ScrollToTop.astro';

interface Props {
    title?: string;
    description?: string;
}

const siteTitle = 'Roaming for Applications | PEI DETI UA';
const {
    title = siteTitle,
    description = 'A PEI project exploring application federation across mobile operators, edge computing close to users, and the GSMA OPG.02 and IPCEI-CIS architecture.',
} = Astro.props;

const pageTitle = title === siteTitle || title === 'Roaming for Applications'
    ? siteTitle
    : `${title} | Roaming for Applications`;
const canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : new URL(Astro.url.pathname, Astro.url.origin);
const favicon = `${import.meta.env.BASE_URL}images/logos/ua.png`;
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
        (function () {
            var stored = localStorage.getItem('theme');
            var theme = stored === 'dark' || stored === 'light'
                ? stored
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/png" />

    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
</head>
<body class="flex min-h-screen flex-col bg-background text-text">
<a href="#main-content" class="skip-link">Skip to content</a>
<Nav />
<main id="main-content" class="flex-1">
    <slot />
</main>
<Footer />
<ScrollToTop />

<script>
    import { initAlignment } from '../../scripts/align';
    initAlignment();
</script>
</body>
</html>
