---
import Logo from '../ui/Logo.astro';
import { url } from '../../lib/paths';

const currentYear = new Date().getFullYear();
const advisors = ['Diogo Gomes (Advisor)', 'Rafael Direito (Co-Advisor)'];
const secondaryLinks = [
    { label: 'Milestones', href: '/milestones' },
    { label: 'Minutes', href: '/minutes' },
    { label: 'Documentation', href: '/documentation' },
];

const university = {
    name: 'Universidade de Aveiro',
    src: '/images/logos/ua.png',
    width: 345,
    href: 'https://www.ua.pt',
};
---

<footer class="footer-panel relative mt-auto overflow-hidden border-t border-line/60">
    <div class="supporter-strip">
        <div class="supporter-strip__inner shell">
            <a
                    href={university.href}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="supporter-strip__university"
            >
                <img
                        src={url(university.src)}
                        alt={university.name}
                        width={university.width}
                        height="128"
                        loading="lazy"
                />
            </a>
        </div>
    </div>
    <div class="shell relative grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_1fr_1fr_1fr] lg:gap-16">
        <div>
            <Logo class="max-w-[15rem] text-xl text-brand md:text-2xl" />
            <p class="meta mt-2.5">Roaming for Applications</p>
        </div>
        <div>
            <p class="meta meta-on">Universidade de Aveiro</p>
            <p class="meta mt-2">DETI · Projeto em Engenharia Informática</p>
            <p class="meta mt-2">2026/2027</p>
        </div>
        <div>
            <p class="meta meta-on">Advisors</p>
            {advisors.map((name) => <p class="meta mt-2">{name}</p>)}
        </div>
        <div class="flex flex-col items-start gap-2.5">
            {secondaryLinks.map((link) => (
                <a href={url(link.href)} class="text-link meta">{link.label}</a>
            ))}
        </div>
    </div>
    <div class="shell relative border-t border-line py-5">
        <p class="meta">© {currentYear} Roaming for Applications. All rights reserved.</p>
    </div>
</footer>

<style>
    .footer-panel {
        background-color: color-mix(in srgb, var(--color-surface) 72%, transparent);
    }

    .footer-panel > .shell {
        position: relative;
        isolation: isolate;
    }

    .footer-panel > .shell::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        background-color: var(--color-background);
        opacity: 0.55;
        z-index: -1;
    }

    .supporter-strip {
        position: relative;
        isolation: isolate;
        background: transparent;
    }

    .supporter-strip__inner {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 132px;
        padding-block: 1.5rem;
    }

    .supporter-strip__university {
        display: flex;
        justify-content: center;
        padding-inline: 1rem;
        opacity: 0.65;
        filter: grayscale(1);
        transition: opacity 300ms;
    }

    .supporter-strip__university:hover {
        opacity: 0.9;
    }

    .supporter-strip__university img {
        width: auto;
        height: clamp(2.5rem, 4.4vw, 4rem);
        max-width: 100%;
        object-fit: contain;
    }

    @media (max-width: 767px) {
        .supporter-strip__inner {
            min-height: 96px;
            padding-block: 1rem;
        }

        .supporter-strip__university img {
            height: clamp(1.75rem, 7vw, 2.75rem);
        }
    }
</style>
