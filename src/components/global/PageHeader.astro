---
interface Props { label: string; title: string; lead?: string; id?: string; }
const { label, title, lead, id = 'page-heading' } = Astro.props;
---
<header class="page-header border-b border-line py-12 md:py-18">
  <div class="shell">
    <p class="meta text-signal">{label}</p>
    <h1 id={id} data-reveal class="mt-4 max-w-5xl font-display font-semibold tracking-[-0.055em]" style="font-size:var(--text-title);line-height:.96">{title}</h1>
    {lead && <p class="mt-6 max-w-3xl text-[1.0625rem] leading-relaxed text-text-soft" data-reveal>{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header { position:relative; overflow:hidden; background:linear-gradient(115deg,var(--color-brand-soft) 0%,var(--color-background) 52%,var(--color-silver-soft) 120%); }
  .page-header::after { content:''; position:absolute; width:24rem; height:1px; right:-5rem; top:42%; background:color-mix(in oklab,var(--color-signal) 42%,transparent); transform:rotate(-13deg); }
</style>
