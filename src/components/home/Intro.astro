---
import LinkArrow from '../ui/LinkArrow.astro';
import AlignmentField from '../brand/AlignmentField.astro';
import { url } from '../../lib/paths';

const frameworks = ['GSMA', 'IPCEI-CIS', 'ETSI'];
---
<section aria-labelledby="intro-heading" class="hero shell grid min-h-[620px] items-center gap-14 py-14 md:grid-cols-[minmax(0,1.02fr)_minmax(340px,.98fr)] md:gap-[7vw] md:py-20">
  <div>
    <p class="meta text-signal">Roaming for Applications · PEI 2026/27</p>
    <h1 id="intro-heading" data-reveal class="mt-4 max-w-4xl font-display font-semibold tracking-[-0.065em]" style="font-size:var(--text-hero);line-height:.9">
      Federated<br /><span class="text-brand">edge roaming.</span>
    </h1>
    <p class="mt-8 max-w-2xl leading-[1.6] text-text-soft" style="font-size:var(--text-lead)" data-reveal>
      Federating edge platforms across telecom operators, based on GSMA and IPCEI-CIS.
    </p>

    <div class="mt-8 flex flex-wrap gap-x-9 gap-y-4">
      <LinkArrow href={url('/project')}>Discover the project</LinkArrow>
      <LinkArrow href={url('/documentation')}>Documentation</LinkArrow>
    </div>

    <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2" aria-label="Frameworks and references">
      {frameworks.map((name) => <li class="meta meta-on">{name}</li>)}
    </ul>
  </div>

  <div class="hero-visual relative min-h-[330px] overflow-hidden bg-brand md:min-h-[390px]" aria-hidden="true">
    <p class="meta absolute left-7 top-7 z-10 text-white/60">Independent platforms → federated roaming</p>
    <div class="absolute inset-x-5 top-16 md:inset-x-8 md:top-14">
      <AlignmentField variant="hero" class="h-full w-full [--color-brand:#FFFFFF] [--color-text:#FFFFFF] [--color-signal:var(--color-signal)]" />
    </div>
  </div>
</section>

<style>
  .hero { position:relative; }
  .hero-visual { background:linear-gradient(145deg,var(--color-brand-deep),var(--color-brand) 55%,var(--color-signal)); box-shadow:18px 18px 0 var(--color-silver-soft); }
  .hero-visual::after { content:''; position:absolute; width:15rem; height:1px; right:-3rem; bottom:3rem; background:rgb(255 255 255 / .4); transform:rotate(-18deg); }
</style>
