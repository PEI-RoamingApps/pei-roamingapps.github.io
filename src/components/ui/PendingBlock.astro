---
interface Props {
    when: string;
}

const { when } = Astro.props;
const coords = ['02.1', '02.2', '02.3', '02.4'];
---

<div class="relative max-w-2xl overflow-hidden border border-dashed border-line bg-surface p-6 sm:p-8">
    <div
            class="pointer-events-none absolute inset-0 opacity-[0.35]"
            style="background-image: linear-gradient(var(--color-line) 1px, transparent 1px), linear-gradient(90deg, var(--color-line) 1px, transparent 1px); background-size: 24px 24px;"
            aria-hidden="true"
    ></div>
    <div class="relative flex items-baseline justify-between">
        <p class="meta meta-on text-brand">Phase 02 / Pending</p>
        <p class="meta">{when}</p>
    </div>
    <p class="relative mt-3.5 text-base leading-relaxed text-text-soft"><slot /></p>
    <div class="relative mt-7 flex flex-wrap gap-x-6 gap-y-2" aria-hidden="true">
        {coords.map((c) => <span class="meta text-muted">{c}</span>)}
    </div>
</div>
