---
import BaseLayout from '../components/layouts/BaseLayout.astro';

const facts = [
  ['Course', 'Projeto em Engenharia Informática'],
  ['Institution', 'Universidade de Aveiro'],
  ['Year', '2026 / 2027'],
  ['Current phase', 'Requirements & Planning'],
];

const flow = [
  ['01', 'Understand', 'Organisation, sector, scope and responsibilities.'],
  ['02', 'Assess', 'Maturity, requirements and gaps.'],
  ['03', 'Organise', 'Policies, procedures and evidence.'],
  ['04', 'Follow up', 'Incidents, actions, indicators and deadlines.'],
];
---
<BaseLayout title="Project" description="What aLinha is: a CISO-as-a-Service platform for cybersecurity compliance workflows in Portuguese SMEs.">
  <header class="border-b border-line py-14 md:py-20">
    <div class="shell">
      <p class="meta text-signal">Project</p>
      <h1 data-reveal class="mt-4 max-w-5xl font-display font-semibold tracking-[-0.055em]" style="font-size:var(--text-title);line-height:.96">What is aLinha?</h1>
    </div>
  </header>

  <section class="py-[var(--space-section)]">
    <div class="shell">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-[7vw]">
        <p class="max-w-2xl font-display font-medium leading-[1.18] tracking-[-0.035em]" style="font-size:var(--text-sub)">
          A shared CISO-as-a-Service model for organisations that need a more structured way to manage cybersecurity compliance.
        </p>
        <p class="max-w-xl text-base leading-[1.7] text-text-soft">
          aLinha centralises core compliance work and uses AI as an assisting layer for drafting, prioritisation and explanation. Responsibility and review remain with people.
        </p>
      </div>

      <div class="mt-14 border-y border-line py-8">
        <div class="grid lg:grid-cols-[180px_repeat(4,minmax(0,1fr))]">
          <div class="flex items-center pr-6"><p class="meta text-signal">Service model</p></div>
          {flow.map(([number, title, body], i) => (
            <article data-reveal class="relative min-h-[170px] border-t border-line p-5 lg:border-l lg:border-t-0 lg:p-6">
              <span class="font-mono text-xs font-medium tracking-[.1em] text-signal">{number}</span>
              <h2 class="mt-11 font-display text-xl font-semibold tracking-[-0.025em]">{title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-text-soft">{body}</p>
              {i < flow.length - 1 && <span class="absolute -right-2 top-1/2 z-10 hidden h-[2px] w-4 -translate-y-1/2 bg-brand lg:block" aria-hidden="true"></span>}
            </article>
          ))}
        </div>

        <div class="mt-5 grid lg:grid-cols-[180px_minmax(0,1fr)]">
          <div class="flex items-center pr-6"><p class="meta text-signal">Across the flow</p></div>
          <div class="flex flex-col gap-3 bg-brand-deep px-5 py-5 text-white sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <p class="text-sm"><strong>AI assistance</strong> · draft, prioritise, explain</p>
            <p class="text-sm"><strong>Human review</strong> · validate, decide, remain accountable</p>
          </div>
        </div>
      </div>

      <dl class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 xl:grid-cols-4">
        {facts.map(([term, value]) => (
          <div class="bg-surface p-5">
            <dt class="meta">{term}</dt>
            <dd class="mt-2 text-[0.95rem] font-medium">{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
